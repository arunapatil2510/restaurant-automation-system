# Server Port
PORT=5000

# Environment
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/restosmart?retryWrites=true&w=majority

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Name
GEMINI_MODEL=gemini-2.5-flash

# Admin & Kitchen Passkey
ADMIN_SECRET_KEY=your_secure_admin_key_here

# Client URL (for CORS validation)
CLIENT_URL=http://localhost:5173
